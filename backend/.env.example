DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/breathconnection
JWT_SECRET=change-me-use-a-long-random-string
PORT=3000
NODE_ENV=development

# Wearable integrations (Terra API)
TERRA_API_KEY=
TERRA_DEV_ID=

# OAuth (Oura)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=breathconnection://wearable/oura/callback

# OAuth (WHOOP)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=breathconnection://wearable/whoop/callback

# Video storage (leave blank to use local disk in dev)
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For Cloudflare R2: set S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Public CDN prefix for video URLs (CloudFront, R2 custom domain, etc.)
CDN_BASE=
