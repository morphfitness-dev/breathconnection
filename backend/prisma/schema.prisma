generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       UserProfile?
  assessment    Assessment?
  programme     Programme?
  sessions      Session[]
  metrics       MetricEntry[]
  boltHistory   BoltScore[]
  holdRecords   BreathHoldRecord[]
  streaks       StreakEntry[]
  wearables     WearableConnection[]
  milestones    UserMilestone[]
  monthlyReports MonthlyReport[]
}

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  stage               String   @default("explorer")  // explorer | practitioner | optimizer | coach
  pillarWeights       String   @default("{\"biomechanics\":33,\"biochemistry\":33,\"neurophysiology\":34}")
  contraindications   String   @default("[]")
  tier                Int      @default(1)
  totalSessions       Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assessment {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  completedAt             DateTime @default(now())

  boltScore               Float?
  restingRR               Float?
  restingHR               Float?
  hrv                     Float?
  breathingPattern        String?  // chest_dominant | diaphragmatic | mixed

  hasStressIssues         Boolean  @default(false)
  hasSleepIssues          Boolean  @default(false)
  hasFocusIssues          Boolean  @default(false)
  hasAnxiety              Boolean  @default(false)
  hasFatigue              Boolean  @default(false)

  primaryGoal             String?
  secondaryGoals          String   @default("[]")

  activityLevel           String?  // sedentary | lightly_active | moderately_active | very_active | athlete
  hasHypertension         Boolean  @default(false)
  hasHeartCondition       Boolean  @default(false)
  hasEpilepsy             Boolean  @default(false)
  isPregnant              Boolean  @default(false)
  hasCOPD                 Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Programme {
  id              String   @id @default(cuid())
  userId          String   @unique
  currentWeek     Int      @default(1)
  startedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  weeklyPlan      String   // JSON: array of day plans
  pillarWeights   String   // JSON: {biomechanics, biochemistry, neurophysiology}
  sessionDuration Int      @default(10)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id              String    @id @default(cuid())
  userId          String
  videoId         String
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  durationSeconds Int?
  pillar          String    // biomechanics | biochemistry | neurophysiology
  tier            Int       @default(1)

  preNsScore      Int?
  postHrv         Float?
  preHrv          Float?
  eegAlphaRatio   Float?
  subjectiveRating Int?    // 1-5
  discomfortReported Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MetricEntry {
  id          String   @id @default(cuid())
  userId      String
  type        String   // hrv | rhr | rr | spo2 | blood_pressure | ns_score | eeg_alpha | daytime_rr
  value       Float
  systolic    Float?
  diastolic   Float?
  source      String   @default("manual")  // manual | oura | whoop | apple_health | tymewear | spire
  context     String?  // sleep | active | resting | morning
  recordedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BoltScore {
  id          String   @id @default(cuid())
  userId      String
  score       Float
  isPersonalRecord Boolean @default(false)
  testedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BreathHoldRecord {
  id              String   @id @default(cuid())
  userId          String
  durationSeconds Float
  isPersonalRecord Boolean @default(false)
  sessionId       String?
  recordedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StreakEntry {
  id            String   @id @default(cuid())
  userId        String
  type          String   // coherence | mindful_sessions | daily_practice
  count         Int      @default(0)
  startedAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
  isActive      Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WearableConnection {
  id            String   @id @default(cuid())
  userId        String
  deviceType    String   // oura | whoop | apple_health | google_health | muse | flowtime | tymewear | spire | hilo
  isConnected   Boolean  @default(false)
  lastSyncedAt  DateTime?
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserMilestone {
  id            String   @id @default(cuid())
  userId        String
  milestoneType String   // bolt_pr | hold_pr | coherence_7 | coherence_30 | coherence_100 | bolt_15 | bolt_25 | bolt_35 | stage_advance | pillar_complete | monthly_report
  achievedAt    DateTime @default(now())
  data          String   @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MonthlyReport {
  id                String   @id @default(cuid())
  userId            String
  reportMonth       String   // YYYY-MM
  boltStart         Float?
  boltEnd           Float?
  rhrStart          Float?
  rhrEnd            Float?
  hrvTrend          String?  // up | stable | down
  rrStart           Float?
  rrEnd             Float?
  topTechniques     String   @default("[]")
  totalSessions     Int      @default(0)
  generatedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Video {
  id                    String  @id
  title                 String
  description           String
  pillar                String  // biomechanics | biochemistry | neurophysiology
  tier                  Int
  durationSeconds       Int
  technique             String
  instructorStyle       String  // warm | clinical | energising | calm
  biometricFeedbackType String  @default("none") // hrv | eeg | breathing_rate | spO2 | blood_pressure | none
  nsScoreMin            Int?
  gamificationEvent     String  @default("milestone_none")
  fourWeekAnchor        Boolean @default(false)
  thumbnailUrl          String?
  videoUrl              String?
  tags                  String  @default("[]")
  contraindicated       String  @default("[]")
  createdAt             DateTime @default(now())
}
